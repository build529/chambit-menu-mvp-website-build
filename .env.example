# Copy this file to .env for local/Codespaces development.
# Never commit the real .env file.

SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=jose
ADMIN_PASSWORD=replace-with-a-strong-password

DATABASE_URL=sqlite:///./data/chambit.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Optional: leave blank until GA4 is configured.
GA_MEASUREMENT_ID=

# Keep false outside local development.
DEBUG=false
ALLOW_DATE_OVERRIDE=false
